<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="@dimen/spacing_medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ProgressBar
            android:id="@+id/result_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txt_result_error"
            style="@style/TextAppearance.CropDoc.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_error_container"
            android:padding="@dimen/spacing_medium"
            android:text="@string/error_result_not_found"
            android:textColor="@color/error_red"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_hero_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="@dimen/radius_large"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline_subtle"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_medium">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/img_scanned_leaf"
                        android:layout_width="@dimen/result_hero_image_size"
                        android:layout_height="@dimen/result_hero_image_size"
                        android:contentDescription="@string/cd_leaf_thumbnail"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_medium"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_crop_and_disease_title"
                            style="@style/TextAppearance.CropDoc.Headline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textIsSelectable="true"
                            android:lineSpacingExtra="4sp" />

                        <TextView
                            android:id="@+id/txt_confidence_value"
                            style="@style/TextAppearance.CropDoc.Caption"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:textIsSelectable="true"
                            android:textColor="@color/primary_green" />

                        <com.google.android.material.progressindicator.LinearProgressIndicator
                            android:id="@+id/progress_confidence"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_xs"
                            android:max="100"
                            app:indicatorColor="@color/primary_green"
                            app:trackColor="@color/secondary_container"
                            app:trackCornerRadius="@dimen/radius_small"
                            app:trackThickness="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_speak_advice"
                    style="@style/Widget.CropDoc.Button.Tonal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:text="@string/btn_listen_audio_advice" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/card_low_confidence_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:background="@color/warning_amber_bg"
            android:orientation="vertical"
            android:padding="@dimen/spacing_medium"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_banner_message"
                style="@style/TextAppearance.CropDoc.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:lineSpacingExtra="4sp"
                android:textColor="@color/warning_amber_text" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_advice_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/surface_card"
                app:cardCornerRadius="@dimen/radius_medium"
                app:cardElevation="0dp"
                app:strokeColor="@color/outline_subtle"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_medium">

                    <TextView
                        style="@style/TextAppearance.CropDoc.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/heading_causes" />

                    <TextView
                        android:id="@+id/txt_causes_body"
                        style="@style/TextAppearance.CropDoc.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textIsSelectable="true"
                        android:lineSpacingExtra="4sp" />

                    <TextView
                        style="@style/TextAppearance.CropDoc.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/heading_cultural_bio" />

                    <TextView
                        android:id="@+id/txt_cultural_control_body"
                        style="@style/TextAppearance.CropDoc.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textIsSelectable="true"
                        android:lineSpacingExtra="4sp" />

                    <TextView
                        android:id="@+id/heading_chemical_cibrc"
                        style="@style/TextAppearance.CropDoc.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/heading_chemical_cibrc" />

                    <TextView
                        android:id="@+id/txt_chemical_control_body"
                        style="@style/TextAppearance.CropDoc.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textIsSelectable="true"
                        android:lineSpacingExtra="4sp" />

                    <TextView
                        style="@style/TextAppearance.CropDoc.SectionTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_medium"
                        android:text="@string/heading_prevention" />

                    <TextView
                        android:id="@+id/txt_prevention_body"
                        style="@style/TextAppearance.CropDoc.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xs"
                        android:textIsSelectable="true"
                        android:lineSpacingExtra="4sp" />

                    <TextView
                        android:id="@+id/txt_source_attribution"
                        style="@style/TextAppearance.CropDoc.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"
                        android:layout_marginTop="@dimen/spacing_medium" />

                    <TextView
                        style="@style/TextAppearance.CropDoc.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_small"
                        android:lineSpacingExtra="3sp"
                        android:text="@string/kvk_safety_disclaimer" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_feedback_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_thumb_up"
                style="@style/Widget.CropDoc.Button.Tonal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_feedback_helpful" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_thumb_down"
                style="@style/Widget.CropDoc.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_small"
                android:layout_weight="1"
                android:text="@string/btn_feedback_unhelpful" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_feedback_thanks"
            style="@style/TextAppearance.CropDoc.SectionTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:background="@drawable/bg_status_pill"
            android:padding="@dimen/spacing_small"
            android:text="@string/feedback_saved_message"
            android:textColor="@color/on_secondary_container"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retake_photo"
            style="@style/Widget.CropDoc.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_medium"
            android:text="@string/btn_retake_photo" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
