<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_small"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="@dimen/radius_medium"
    app:cardElevation="0dp"
    app:strokeColor="@color/outline_subtle"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/min_touch_target"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_medium">

        <ImageView
            android:id="@+id/img_leaf_thumb"
            android:layout_width="@dimen/thumb_size"
            android:layout_height="@dimen/thumb_size"
            android:contentDescription="@string/cd_leaf_thumbnail"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_item_disease"
                style="@style/TextAppearance.CropDoc.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingExtra="3sp"
                android:maxLines="2" />

            <TextView
                android:id="@+id/txt_item_confidence"
                style="@style/TextAppearance.CropDoc.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="@color/primary_green" />

            <TextView
                android:id="@+id/txt_item_timestamp"
                style="@style/TextAppearance.CropDoc.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs" />

            <TextView
                android:id="@+id/txt_sync_badge"
                style="@style/TextAppearance.CropDoc.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="@dimen/spacing_small"
                android:paddingTop="@dimen/spacing_xs"
                android:paddingEnd="@dimen/spacing_small"
                android:paddingBottom="@dimen/spacing_xs"
                android:textColor="@color/on_secondary_container" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
