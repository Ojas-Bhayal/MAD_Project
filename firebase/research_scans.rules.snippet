// Add this function and match INSIDE your existing
// service cloud.firestore { match /databases/{database}/documents { ... } block.
// The existing isOwner(userId) helper is reused. Do not add a duplicate helper.

function isValidResearchScanPayload(data, userId, scanId) {
  return data.keys().hasAll([
      'scanId', 'userId', 'cropKey', 'status', 'classId', 'modelScore',
      'scoreType', 'inferenceTimeMs', 'timestampMs', 'message', 'modelType', 'researchOnly'
    ])
    && data.keys().hasOnly([
      'scanId', 'userId', 'cropKey', 'status', 'classId', 'modelScore',
      'scoreType', 'inferenceTimeMs', 'timestampMs', 'message', 'modelType', 'researchOnly'
    ])
    && data.scanId is string && data.scanId == scanId && data.scanId.size() <= 64
    && data.userId is string && data.userId == userId
    && data.cropKey is string && data.cropKey in ['rice', 'groundnut', 'cotton']
    && data.status is string && data.status in ['RESULT', 'REJECTED', 'UNAVAILABLE']
    && data.classId is string && data.classId.size() <= 64
    && data.modelScore is number && data.modelScore >= 0.0 && data.modelScore <= 1.0
    && data.scoreType == 'uncalibrated_model_score'
    && data.inferenceTimeMs is int && data.inferenceTimeMs >= 0
    && data.timestampMs is int && data.timestampMs > 0
    && data.message is string && data.message.size() <= 500
    && data.modelType == 'debug_research_scan'
    && data.researchOnly == true;
}

// Keep experimental metadata separate from verified production diagnoses.
match /users/{userId}/research_scans/{scanId} {
  allow read: if isOwner(userId);
  allow create, update: if isOwner(userId)
    && isValidResearchScanPayload(request.resource.data, userId, scanId);
  allow delete: if isOwner(userId);
}
